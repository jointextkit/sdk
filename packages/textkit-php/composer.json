{
    "name": "jointextkit/textkit",
    "description": "Official PHP client for TextKit (jointextkit.com): SMS, phone verification, and phone numbers. No dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "otp", "phone verification", "2fa", "sms api", "webhooks"],
    "homepage": "https://jointextkit.com",
    "authors": [{ "name": "Truelabel Inc" }],
    "support": { "docs": "https://jointextkit.com/docs" },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "TextKit\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TextKit\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
